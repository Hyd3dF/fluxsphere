# Frontend origin used to build OAuth callback URLs.
# Use the deployed app origin in production, for example https://fluxsphere.sbs.
PUBLIC_APP_URL=http://localhost:5174

# Supabase project URL and anon key are public browser configuration.
# Never place service-role keys, JWT secrets, or OAuth client secrets in PUBLIC_* vars.
PUBLIC_SUPABASE_URL=https://your-supabase-project.example.com
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
